# Copy to .env and fill in. Never commit .env.

# Claude API key (https://console.anthropic.com). Used to tailor the resume per job.
ANTHROPIC_API_KEY=

# Optional: only needed if apply.email.send is true (C2C boards where you apply by email).
# For Outlook/Hotmail use smtp-mail.outlook.com:587 and an app password.
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
